POSTGRES_PASSWORD=change-this-postgres-password

# MQTT broker credentials.
# Currently unused because mosquitto runs with allow_anonymous true for the local test phase.
# They must match the mosquitto password file once authentication is enabled.
MQTT_USER=vrfb1
MQTT_PASSWORD=change-this-mqtt-password

API_KEY=change-this-api-key

# Optional: override CORS if you access the API directly from another origin.
# With the nginx proxy the web app talks same-origin, so this is usually not needed.
CORS_ORIGINS=http://localhost
